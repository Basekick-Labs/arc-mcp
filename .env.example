# Copy this file to .env and fill in values:
#   cp .env.example .env

# Arc API token — required. In a fresh `arc` container the default admin
# token is printed to the container logs on first start; grab it with:
#   docker compose logs arc | grep -i token
ARC_TOKEN=

# Where to reach Arc from arc-mcp's perspective.
# - If using `docker compose --profile with-arc up`: leave unset (defaults to http://arc:8000).
# - If Arc runs on the Docker host: http://host.docker.internal:8000
# - If Arc runs elsewhere: https://arc.example.com
#ARC_URL=

# Image versions.
ARC_VERSION=latest
ARC_MCP_VERSION=26.04.2

# Host port mappings.
ARC_PORT=8000
ARC_MCP_PORT=8080

# Row cap passed to arc-mcp.
ARC_MCP_MAX_ROWS=500
