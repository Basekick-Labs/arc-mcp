# Copy this file to .env and fill in values:
#   cp .env.example .env

# Arc API token — required. In a fresh `arc` container the default admin
# token is printed to the container logs on first start; grab it with:
#   docker compose logs arc | grep -i token
ARC_TOKEN=

# Bearer token MCP clients send to arc-mcp — required. Generate one with:
#   openssl rand -hex 32
ARC_MCP_HTTP_TOKEN=

# Where to reach Arc from arc-mcp's perspective.
# - If using `docker compose --profile with-arc up`: leave unset (defaults to http://arc:8000).
# - If Arc runs on the Docker host: http://host.docker.internal:8000
# - If Arc runs elsewhere: https://arc.example.com
#ARC_URL=

# Image versions.
ARC_VERSION=latest
# arc-mcp 27.01 or later: earlier images have no --transport http.
ARC_MCP_VERSION=latest

# Host port mappings.
ARC_PORT=8000
ARC_MCP_PORT=8080

# Row cap passed to arc-mcp.
ARC_MCP_MAX_ROWS=500

# Tool groups: data (the default), or data,ops to add Arc's health and
# metrics tools (see "Operations tools" in the README); add enterprise for
# Arc's licence, clustering and schedulers ("Enterprise tool").
#ARC_MCP_TOOLS=data
